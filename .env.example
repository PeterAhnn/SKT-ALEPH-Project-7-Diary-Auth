# T07 local environment. Never copy T06 .env or .vercel credentials here.
PORT=8009
DIARY_AUTH_DIRECTORY=.data/t07
DIARY_RECORD_ORIGIN=user
# Production requires HTTPS and a persistent authenticated storage adapter.
# The serverless API currently fails closed; public deployment is pending.
# Optional dedicated cloud backend. Real values stay in ignored .env.cloud.local
# and encrypted Vercel environment variables; never copy the T06 environment.
T07_PROJECT_REF=
T07_PG_HOST=
T07_PG_PORT=6543
T07_PG_USER=
T07_PG_PASSWORD=
T07_PG_CA=
